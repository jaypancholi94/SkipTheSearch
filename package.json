{
  "name": "spellbook",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Jay Pancholi <jaypancholi94@gmail.com>",
  "license": "MIT",
  "packageManager": "bun",
  "dependencies": {
    "vitepress": "^1.6.0"
  },
  "scripts": {
    "dev": "vitepress dev docs --port 4321",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"docs/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{md,css,json,jsonc,ts,mts,js,mjs,yaml,yml}": "prettier --write"
  },
  "overrides": {
    "reurl": "git+https://github.com/jsepia/reurl.git#commonjs"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "markdown-it-wikilinks": "^1.4.0",
    "markdownlint-cli2": "^0.21.0",
    "mermaid": "^10.9.1",
    "prettier": "^3.8.1",
    "sitemap": "^8.0.0",
    "typescript": "^5.1.6",
    "vitepress-plugin-mermaid": "^2.0.16",
    "vitepress-sidebar": "^1.10.0"
  },
  "trustedDependencies": [
    "less",
    "reurl"
  ]
}
